# DB 접속 문자열. 미설정이면 프로젝트 루트의 로컬 SQLite(naran.db)로 폴백한다.
# docker compose는 컨테이너 볼륨의 SQLite 경로를 따로 지정한다.
DATABASE_URL=

# CORS 허용 오리진 추가 (콤마 구분). 로컬 개발은 기본값으로 충분하다.
ALLOWED_ORIGINS=

# 화면의 "Gemini 실시간" 분석에만 사용한다. 비워 두면 "검증 저장값" 분석만 가능하다.
# 분석 모드는 환경변수가 아니라 화면에서 실행할 때마다 선택한다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=60
