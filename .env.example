# DB 접속 문자열. 미설정이면 /health는 정상 응답하고 /health/db만 503을 반환한다.
DATABASE_URL=

# CORS 허용 오리진 추가 (콤마 구분). 로컬 개발은 기본값으로 충분하다.
ALLOWED_ORIGINS=

# Gemini structured output 추출에 사용. 미설정이면 demo(verified_cache) 모드로 동작한다.
GEMINI_API_KEY=

# live | demo | live_then_cache. 기본값은 demo — claude.md 14절.
NARAN_EXECUTION_MODE=demo
